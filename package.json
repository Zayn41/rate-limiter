{
  "name": "nexus-limiter",
  "version": "1.0.12",
  "description": "Production-ready rate limiter for Node.js — token bucket, sliding window, fixed window. Express, Fastify, NestJS, Hono support. Redis and in-memory stores.",
  "author": "Zayn Khan",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./redis": {
      "types": "./dist/store/redis-export.d.ts",
      "import": "./dist/store/redis-export.js",
      "require": "./dist/store/redis-export.cjs"
    },
    "./middleware/express": {
      "types": "./dist/middleware/express.d.ts",
      "import": "./dist/middleware/express.js",
      "require": "./dist/middleware/express.cjs"
    },
    "./middleware/fastify": {
      "types": "./dist/middleware/fastify.d.ts",
      "import": "./dist/middleware/fastify.js",
      "require": "./dist/middleware/fastify.cjs"
    },
    "./middleware/hono": {
      "types": "./dist/middleware/hono.d.ts",
      "import": "./dist/middleware/hono.js",
      "require": "./dist/middleware/hono.cjs"
    },
    "./middleware/nestjs": {
      "types": "./dist/middleware/nestjs.d.ts",
      "import": "./dist/middleware/nestjs.js",
      "require": "./dist/middleware/nestjs.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:tsc": "tsc && node scripts/copyLua.js",
    "test": "vitest run",
    "test:unit": "vitest run --exclude **/*.integration.test.ts",
    "test:integration": "vitest run --fileParallelism=false src/tests/**/*.integration.test.ts",
    "test:e2e": "vitest run --fileParallelism=false src/tests/e2e",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "throttle",
    "throttling",
    "express",
    "fastify",
    "nestjs",
    "hono",
    "redis",
    "token-bucket",
    "sliding-window",
    "fixed-window",
    "middleware",
    "typescript",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zayn41/rate-limiter.git"
  },
  "bugs": {
    "url": "https://github.com/Zayn41/rate-limiter/issues"
  },
  "homepage": "https://github.com/Zayn41/rate-limiter#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "fastify": ">=4.0.0",
    "hono": ">=4.0.0",
    "ioredis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.40",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "dotenv": "^16.0.0",
    "express": "^5.0.0",
    "fastify": "^5.0.0",
    "hono": "^4.0.0",
    "ioredis": "^5.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
